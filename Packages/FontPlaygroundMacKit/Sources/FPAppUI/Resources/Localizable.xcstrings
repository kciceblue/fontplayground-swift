    "This clears your fonts and names. Your sample text stays, and fonts you saved or installed are not affected.": {
      "comment": "shell.startOverMessage",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears your fonts and names. Your sample text stays, and fonts you saved or installed are not affected."
