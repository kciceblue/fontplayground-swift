    "Font Playground found settings from an earlier version but couldn't read them.": {
      "comment": "shell.importFailed",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Font Playground found settings from an earlier version but couldn't read them."
