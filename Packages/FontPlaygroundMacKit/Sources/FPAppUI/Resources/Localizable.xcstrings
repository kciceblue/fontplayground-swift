    "To use a font file, add the folder it's in with File › Add Font Folder…, or install it with Font Book.": {
      "comment": "shell.fileDropped",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use a font file, add the folder it's in with File › Add Font Folder…, or install it with Font Book."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用字体文件，请通过“文件” › “添加字体文件夹…”添加它所在的文件夹，或用字体册安装它。"
