+def normalize_cmap(font: TTFont) -> None:
+    """Rebuild cmap as Windows (3,1) format 4 [+ (3,10) format 12], keeping any format 14.
+
+    fontTools.merge only reads (3,1)/(0,3)/(0,4)/(0,6) format 4 and (3,10)/(0,4)/(0,6) format 12; many Apple
+    fonts (Helvetica Neue, Didot, Cochin, Zapfino...) only have (0,1) or (0,0) Unicode subtables and would lose
+    every character in the merge.
+    """
+    from fontTools.ttLib.tables._c_m_a_p import CmapSubtable
+    best = font.getBestCmap() or {}
+    uvs = [t for t in font["cmap"].tables if t.format == 14]
+    table = newTable("cmap")
+    table.tableVersion = 0
+    table.tables = []
+    bmp = CmapSubtable.newSubtable(4)
+    bmp.platformID, bmp.platEncID, bmp.language = 3, 1, 0
+    bmp.cmap = {cp: g for cp, g in best.items() if cp <= 0xFFFF}
+    table.tables.append(bmp)
+    if any(cp > 0xFFFF for cp in best):
+        full = CmapSubtable.newSubtable(12)
+        full.platformID, full.platEncID, full.language = 3, 10, 0
+        full.cmap = dict(best)
+        table.tables.append(full)
+    for t in uvs:
+        t.platformID, t.platEncID = 0, 5
+        table.tables.append(t)
+    font["cmap"] = table
+
+
