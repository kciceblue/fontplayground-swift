@@ -0,0 +1,152 @@
+"""MacInstaller prototype. Runs on macOS only; every install goes into tmp_path with kCTFontManagerScopeProcess, so
+fontd, ~/Library/Fonts and the Trash are never touched."""
+import shutil
+import sys
+
+import pytest
+from fontTools.ttLib import TTFont
+
+from fontplayground.engine.merge import set_names
+from fontplayground.engine.spec import ForgeReport
+from fontplayground.ui import build as build_module
+from fontplayground.ui import model as model_module
+from fontplayground.ui import workers
+from fontplayground.ui.build import BuildController, BuildState
+from fontplayground.ui.model import ForgeModel
+from tests.fixtures import build_font, cps
+
+pytestmark = pytest.mark.skipif(sys.platform != "darwin", reason="CoreText is macOS only")
+
+CoreText = pytest.importorskip("CoreText")
+from fontplayground.ui.install_macos import MacInstaller  # noqa: E402
+
+
+def forged(path, family, style="Regular", chars="abc"):
+    p = build_font(path, family, style, cps(chars))
+    f = TTFont(str(p))
+    set_names(f, family, style, ["Fixture A Regular"])
+    f.save(str(p))
+    f.close()
+    return p
+
+
+def families():
+    return set(CoreText.CTFontManagerCopyAvailableFontFamilyNames())
+
+
+@pytest.fixture
+def mac(tmp_path):
+    inst = MacInstaller(tmp_path / "Fonts", scope=CoreText.kCTFontManagerScopeProcess, use_trash=False)
+    yield inst
+    for p in (tmp_path / "Fonts").glob("*.ttf"):   # leave nothing registered in this process
+        inst._remove(p, to_trash=False)
+
+
+def test_install_update_uninstall_round_trip(mac, tmp_path):
+    src = forged(tmp_path / "Mac Probe-Regular.ttf", "Mac Probe", chars="abc")
+    dest = mac.install_font_for_user(src, "Mac Probe Regular")
+    assert dest == tmp_path / "Fonts" / "Mac Probe-Regular.ttf" and dest.read_bytes() == src.read_bytes()
+    assert "Mac Probe" in families()
+    assert mac.installed_path("mac probe regular") == dest and mac.is_forged(dest)
+    assert [f.domain for f in mac.find_family("Mac Probe")] == ["user"]
+    assert not list((tmp_path / ".fontplayground-staging").iterdir())
+
+    newer = forged(tmp_path / "Mac Probe-Regular.ttf", "Mac Probe", chars="abcdef")   # Update, same name
+    assert mac.install_font_for_user(newer, "Mac Probe Regular") == dest and dest.read_bytes() == newer.read_bytes()
+    assert sorted(p.name for p in (tmp_path / "Fonts").iterdir()) == ["Mac Probe-Regular.ttf"]
+
+    assert mac.uninstall_font_for_user("Mac Probe Regular") is True
+    assert not dest.exists() and "Mac Probe" not in families()
+    assert mac.uninstall_font_for_user("Mac Probe Regular") is False
+    assert mac.installed_path("Mac Probe Regular") is None
+
+
+def test_an_earlier_copy_under_another_file_name_is_replaced_not_duplicated(mac, tmp_path):
+    fonts = tmp_path / "Fonts"
+    fonts.mkdir()
+    old = forged(fonts / "renamed-by-user.ttf", "Mac Dup", chars="ab")
+    src = forged(tmp_path / "Mac Dup-Regular.ttf", "Mac Dup", chars="abcd")
+    dest = mac.install_font_for_user(src, "Mac Dup Regular")
+    assert dest.name == "Mac Dup-Regular.ttf" and not old.exists()
+    assert [f.path.name for f in mac.find_postscript("MacDup-Regular")] == ["Mac Dup-Regular.ttf"]
+
+
+def test_another_font_holding_the_file_name_is_left_alone(mac, tmp_path):
+    fonts = tmp_path / "Fonts"
+    fonts.mkdir()
+    theirs = build_font(fonts / "Mac Other-Regular.ttf", "Somebody Else", "Regular", cps("ab"))
+    src = forged(tmp_path / "Mac Other-Regular.ttf", "Mac Other", chars="ab")
+    dest = mac.install_font_for_user(src, "Mac Other Regular")
+    assert dest.name == "Mac Other-Regular-1.ttf" and theirs.exists()
+
+
+def test_system_wide_lookups_see_what_the_catalog_cannot(mac):
+    assert {f.domain for f in mac.find_family("Helvetica")} == {"system"}
+    pingfang = mac.find_family("苹方-简")                       # native name, file lives in AssetsV2
+    assert pingfang and {f.domain for f in pingfang} == {"system"}
+    assert "AssetsV2" in str(pingfang[0].path) or "FontServices" in str(pingfang[0].path)
+    assert {f.domain for f in mac.find_postscript("Helvetica-Bold")} == {"system"}
+    assert mac.find_family("No Such Family 4711") == []
