+def test_controller_install_update_rename_uninstall(qtbot, controller, mac, tmp_path):
+    m = controller.model
+    m.set_family("Mac Flow")
+    assert controller.conflict() == ("none", "")
+    controller.install()
+    qtbot.waitUntil(lambda: controller.state is BuildState.INSTALLED, timeout=10000)
+    assert controller.installed_path == tmp_path / "Fonts" / "Mac Flow-Regular.ttf"
+    assert "Mac Flow" in families()
+
+    m.set_style("Bold")                                    # Update under a new name: the Regular goes
+    controller.install()
+    qtbot.waitUntil(lambda: controller.state is BuildState.INSTALLED and controller.installed_name == "Mac Flow Bold",
+                    timeout=10000)
+    assert sorted(p.name for p in (tmp_path / "Fonts").iterdir()) == ["Mac Flow-Bold.ttf"]
+
+    controller.reset()                                     # a later session: the font is found again and is ours
+    assert controller.conflict() == ("replace", "Replace the “Mac Flow Bold” you installed earlier?")
+    m.set_style("Regular")
+    assert controller.conflict() == ("none", "")          # another style of our family replaces nothing
+
+    controller.model.set_style("Bold")
+    controller.installed_name = "Mac Flow Bold"
+    controller.uninstall()
+    assert controller.notice == "Removed from your fonts." and not list((tmp_path / "Fonts").glob("*.ttf"))
+    assert "Mac Flow" not in families()
