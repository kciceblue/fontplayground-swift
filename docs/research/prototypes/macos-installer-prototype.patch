+++ b/fontplayground/ui/install_macos.py	2026-09-29 18:35:05
@@ -0,0 +1,261 @@
+"""Per-user font install on macOS, no admin rights needed (PROTOTYPE from the macOS gap analysis).
+
+Installing = put the file into ~/Library/Fonts, the folder Font Book's "Current User" install uses. fontd watches it,
+activates the font for every app and posts kCTFontManagerRegisteredFontsChangedNotification (the macOS counterpart of
+WM_FONTCHANGE: nothing to broadcast by hand). Uninstalling moves the file to the Trash, as Font Book's Remove does.
+
+"Installed by us" = a file in the user font folder whose name ID 4 is the full name (installed_path) and whose name
+ID 0 carries FORGED_NOTICE (is_forged) - the same two facts the Windows registry value + is_forged give.
+
+CoreText (pyobjc-framework-CoreText) is used for questions about fonts the file scan cannot see: Apple fonts in
+/System/Library/AssetsV2 (PingFang...), fonts activated by font managers, fonts offered for download, native
+(localised) family names and PostScript names. `scope` exists for tests: kCTFontManagerScopeProcess makes an
+install visible to this process only, without fontd. Nothing here needs Qt.
+"""
+from __future__ import annotations
+
+import os
+import sys
+import uuid
+from dataclasses import dataclass
+from pathlib import Path
+
+from fontplayground.ui.install import InstallNotSupported, full_name_of, is_forged  # shared, platform-neutral helpers
+
+FONT_SUFFIXES = (".ttf", ".otf", ".ttc", ".otc")
+MAX_RENAMES = 99
+# Apple-owned font locations: the system fonts, the fonts macOS downloads on demand (AssetsV2, e.g. PingFang) and the
+# reserved UI fonts. /Library/Fonts is the machine-wide folder (an admin or an installer put fonts there).
+APPLE_PREFIXES = ("/System/Library/", "/Library/Apple/")
+LOCAL_FONTS = "/Library/Fonts/"
+
+# CoreText error codes (CTFontManagerErrors.h)
+ALREADY_REGISTERED, NOT_REGISTERED = 105, 201
+
+
+@dataclass(frozen=True)
+class ExistingFont:
+    """A face some part of the system already knows by a name."""
+    path: Path | None          # None: offered for download by Apple, not on disk yet
+    family: str
+    style: str
+    postscript: str
+    domain: str                # "system" | "local" | "user" | "other" | "downloadable"
+
+
+class MacInstaller:
+    os_name = "macOS"
+
+    def __init__(self, fonts_dir: str | Path | None = None, scope: int | None = None, use_trash: bool = True,
+                 staging_dir: str | Path | None = None) -> None:
+        self.fonts_dir = Path(fonts_dir) if fonts_dir is not None else Path.home() / "Library" / "Fonts"
+        self.staging_dir = Path(staging_dir) if staging_dir is not None else (
+            Path.home() / "Library" / "Caches" / "FontPlayground" if fonts_dir is None else None)
+        self.scope = scope            # None: let fontd activate ~/Library/Fonts; tests pass kCTFontManagerScopeProcess
+        self.use_trash = use_trash
+
+    # ----- the interface BuildController uses -----
+    def is_supported(self) -> bool:
+        return sys.platform == "darwin"
+
+    def user_fonts_dir(self) -> Path:
+        return self.fonts_dir
+
+    def system_font_dirs(self) -> list[Path]:
+        """Folders whose fonts belong to macOS or to every user of this Mac (a name there is never replaced)."""
+        return [Path("/System/Library/Fonts"), Path("/System/Library/AssetsV2"),
+                Path("/System/Library/PrivateFrameworks/FontServices.framework"), Path("/Library/Fonts")]
+
+    def is_forged(self, path) -> bool:
+        return is_forged(path)
+
+    def installed_path(self, full_name: str) -> Path | None:
+        """The file in the user font folder whose full name is `full_name` (case-insensitive), or None."""
+        self._require_mac()
+        wanted = full_name.strip().casefold()
+        try:
+            entries = sorted(self.fonts_dir.iterdir())
+        except FileNotFoundError:
+            return None
+        for p in entries:
+            if p.name.startswith(".") or p.suffix.lower() not in FONT_SUFFIXES or not p.is_file():
+                continue
+            try:
+                names = full_name_of(p)
+            except Exception:  # an unreadable file in the folder is not ours to judge
+                continue
+            if wanted in (n.strip().casefold() for n in names.split(" & ")):
+                return p
+        return None
+
+    def install_font_for_user(self, path, full_name: str | None = None) -> Path:
+        """Put the font into the user font folder and return where it now lives.
+
+        An earlier copy under the same full name is replaced (removed, even when it had another file name, so two
+        files never share one PostScript name). A different font already using the file name is left alone: the new
+        file gets '<stem>-<n><suffix>'. The copy is written in a staging folder and renamed into place, so fontd never
+        sees a half-written font and apps that have the old file mapped keep reading a consistent file.
+        """
+        self._require_mac()
+        src = Path(path)
+        if not src.is_file():
+            raise FileNotFoundError(f"Font file not found: {src}")
+        full_name = full_name or full_name_of(src)
+        self.fonts_dir.mkdir(parents=True, exist_ok=True)
+        previous = self.installed_path(full_name)
+        if previous is not None and _same_file(src, previous):
+            return previous                         # installing from the font folder itself
+        dest = self._free_dest(src, previous)
+        # Write the whole file OUTSIDE the watched folder first (fontd must never see a half-written font), then
+        # rename it into place: same volume, so the rename is atomic and apps that mapped an older file keep it.
+        staging = self.staging_dir if self.staging_dir is not None else self.fonts_dir.parent / ".fontplayground-staging"
+        staging.mkdir(parents=True, exist_ok=True)
+        tmp = staging / f"{uuid.uuid4().hex[:8]}-{dest.name}"
+        try:
+            with open(src, "rb") as r, open(tmp, "wb") as w:
+                while chunk := r.read(1 << 20):
+                    w.write(chunk)
+                w.flush()
+                os.fsync(w.fileno())
+            if previous is not None and not _same_file(previous, dest):
+                self._remove(previous, to_trash=False)   # never two files with one PostScript name
+            os.replace(tmp, dest)                        # EXDEV (another volume) surfaces as OSError: install fails
+        finally:
+            tmp.unlink(missing_ok=True)
+        if self.scope is not None:
+            _register([dest], self.scope)
+        return dest
+
+    def uninstall_font_for_user(self, full_name: str) -> bool:
+        """Undo install_font_for_user for the font with this full name. False when it was not installed."""
+        self._require_mac()
+        installed = self.installed_path(full_name)
+        if installed is None:
+            return False
+        self._remove(installed, to_trash=self.use_trash)   # like Font Book's Remove: recoverable from the Trash
+        return True
+
+    # ----- what conflict() needs beyond the catalog -----
+    def find_family(self, family: str) -> list[ExistingFont]:
+        """Every face the system knows under this family name - English or native, any case - wherever it lives,
+        plus Apple fonts offered for download that have it."""
+        import CoreText
+
+        found = _match({CoreText.kCTFontFamilyNameAttribute: family}, CoreText.kCTFontFamilyNameAttribute)
+        found += [f for f in _match({CoreText.kCTFontFamilyNameAttribute: family,
+                                     CoreText.kCTFontDownloadableAttribute: True},
+                                    CoreText.kCTFontDownloadableAttribute)
+                  if f.family.casefold() == family.strip().casefold()]
+        return [self._classify(f) for f in found]
+
+    def find_postscript(self, postscript: str) -> list[ExistingFont]:
+        """Faces registered under this PostScript name (the name documents and most Mac apps store)."""
+        import CoreText
+
+        return [self._classify(f) for f in _match({CoreText.kCTFontNameAttribute: postscript},
+                                                  CoreText.kCTFontNameAttribute)
+                if f.postscript.casefold() == postscript.casefold()]
+
+    # ----- internals -----
+    def _require_mac(self) -> None:
+        if not self.is_supported():
+            raise InstallNotSupported("Installing fonts this way is only supported on macOS.")
+
+    def _classify(self, f: ExistingFont) -> ExistingFont:
+        if f.domain == "downloadable" or f.path is None:
+            return f
+        p = os.path.realpath(f.path)
+        user = os.path.realpath(self.fonts_dir) + os.sep
+        if p.casefold().startswith(user.casefold()):
+            domain = "user"
+        elif p.startswith(APPLE_PREFIXES):
+            domain = "system"
+        elif p.startswith(LOCAL_FONTS):
+            domain = "local"
+        else:
+            domain = "other"       # activated by a font manager (Adobe Fonts, RightFont...) or another app
+        return ExistingFont(f.path, f.family, f.style, f.postscript, domain)
+
+    def _free_dest(self, src: Path, previous: Path | None) -> Path:
+        candidates = [self.fonts_dir / src.name] + [self.fonts_dir / f"{src.stem}-{n}{src.suffix}"
+                                                    for n in range(1, MAX_RENAMES + 1)]
+        for dest in candidates:
+            if not dest.exists() or (previous is not None and _same_file(dest, previous)):
+                return dest
+        raise OSError(f"No free file name for {src.name} in {self.fonts_dir}")
+
+    def _remove(self, path: Path, to_trash: bool) -> None:
+        if self.scope is not None:
+            _unregister([path], self.scope)
+        if to_trash:
+            _trash(path)
+        else:
+            path.unlink(missing_ok=True)
+
+
+# ----- CoreText / Foundation via pyobjc -----
+def _url(path):
+    from Foundation import NSURL
+
+    return NSURL.fileURLWithPath_(str(path))
+
+
+def _match(attributes: dict, mandatory) -> list[ExistingFont]:
+    import CoreText
+
+    desc = CoreText.CTFontDescriptorCreateWithAttributes(attributes)
+    out = []
+    for d in CoreText.CTFontDescriptorCreateMatchingFontDescriptors(desc, {mandatory}) or []:
+        url = CoreText.CTFontDescriptorCopyAttribute(d, CoreText.kCTFontURLAttribute)
+        downloadable = bool(CoreText.CTFontDescriptorCopyAttribute(d, CoreText.kCTFontDownloadableAttribute)) \
+            and url is None
+        out.append(ExistingFont(
+            path=Path(url.path()) if url is not None else None,
+            family=str(CoreText.CTFontDescriptorCopyAttribute(d, CoreText.kCTFontFamilyNameAttribute) or ""),
+            style=str(CoreText.CTFontDescriptorCopyAttribute(d, CoreText.kCTFontStyleNameAttribute) or ""),
+            postscript=str(CoreText.CTFontDescriptorCopyAttribute(d, CoreText.kCTFontNameAttribute) or ""),
+            domain="downloadable" if downloadable else ""))
+    return out
+
+
+def _ct_errors(call, paths, *args) -> list:
+    errors: list = []
+
+    def handler(errs, done):
+        errors.extend(errs)
+        return True
+    call([_url(p) for p in paths], *args, handler)
+    return errors
+
+
+def _register(paths, scope: int) -> None:
+    import CoreText
+
+    errs = [e for e in _ct_errors(CoreText.CTFontManagerRegisterFontURLs, paths, scope, True)
+            if int(e.code()) != ALREADY_REGISTERED]
+    if errs:
+        raise OSError(str(errs[0].localizedDescription()))
+
+
+def _unregister(paths, scope: int) -> None:
+    import CoreText
+
+    errs = [e for e in _ct_errors(CoreText.CTFontManagerUnregisterFontURLs, paths, scope)
+            if int(e.code()) != NOT_REGISTERED]
+    if errs:
+        raise OSError(str(errs[0].localizedDescription()))
+
+
+def _trash(path: Path) -> None:
+    from Foundation import NSFileManager
+
+    ok, _url_out, error = NSFileManager.defaultManager().trashItemAtURL_resultingItemURL_error_(_url(path), None, None)
+    if not ok:
+        raise OSError(str(error.localizedDescription()) if error is not None else f"Could not move {path} to the Trash")
+
+
+def _same_file(a: Path, b: Path) -> bool:
+    try:
+        return os.path.samefile(a, b)
+    except OSError:
+        return False
