    "NSDocumentsFolderUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Font Playground reads fonts in folders you add and saves fonts where you choose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字体混搭会读取你添加的文件夹中的字体，并将字体存储到你选择的位置。"
          }
        }
      }
    },
